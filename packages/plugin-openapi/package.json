{
  "name": "@rspress/plugin-openapi",
  "version": "2.0.21",
  "description": "Generate native Rspress API documentation and an interactive playground from OpenAPI.",
  "bugs": "https://github.com/web-infra-dev/rspress/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-infra-dev/rspress.git",
    "directory": "packages/plugin-openapi"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./style.css": "./static/style.css"
  },
  "module": "./dist/cli/index.js",
  "types": "./dist/cli/index.d.ts",
  "files": [
    "dist",
    "static"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib -w",
    "reset": "rimraf ./**/node_modules"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.1.3",
    "@scalar/openapi-upgrader": "^0.2.15",
    "@scalar/snippetz": "^0.9.30"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "~2.1.0",
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@rspress/core": "workspace:^2.0.10",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
