  },
  "dependencies": {
    "@rstackjs/create-toolkit": "2.2.5"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "^22.8.1",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
