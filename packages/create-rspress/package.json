{
  "name": "create-rspress",
  "version": "2.0.21",
  "description": "Create a new Rspress project",
  "homepage": "https://rspress.rs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-infra-dev/rspress.git",
    "directory": "packages/create-rspress"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "bin": {
    "create-rspress": "./bin.js"
  },
  "files": [
    "template-*/**",
    "dist",
    "bin.js"
  ],
  "scripts": {
    "build": "node ./scripts/generate-theme-templates.mjs && rs lib",
